{
  "name": "retromarket-api",
  "version": "1.0.0",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint .",
    "test": "NODE_ENV=test jest --runInBand",
    "test:security": "NODE_ENV=test jest tests/security.test.js --runInBand",
    "seed": "node scripts/seed.js"
  },
  "dependencies": {
    "express": "4.19.2",
    "pg": "8.11.3",
    "pg-hstore": "2.3.4",
    "sequelize": "6.35.2",
    "bcrypt": "5.1.1",
    "jsonwebtoken": "8.5.1",
    "lodash": "4.17.15",
    "zod": "3.22.4",
    "cors": "2.8.5",
    "helmet": "7.1.0",
    "express-rate-limit": "7.1.5",
    "morgan": "1.10.0",
    "dotenv": "16.3.1"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "eslint-plugin-security": "^4.2.0",
    "nodemon": "3.0.2",
    "jest": "29.7.0",
    "supertest": "6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": ["<rootDir>/jest.setup.js"],
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ]
  }
}
